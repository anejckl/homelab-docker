# Copy this to .env and fill in your values
# docker-compose.yml picks up .env automatically

# Redmine
REDMINE_DB_PASSWORD=change_me
REDMINE_SECRET_KEY_BASE=generate_with_openssl_rand_hex_64
REDMINE_API_KEY=your_redmine_api_key

# Grafana
GF_ADMIN_PASSWORD=change_me

# Fathom log aggregator
FATHOM_USER=admin
FATHOM_PASSWORD=change_me
FATHOM_SECRET=generate_with_openssl_rand_hex_32

# Frigate camera RTSP passwords
CAMERA_DVORISCE_PASS=your_camera_password
CAMERA_TERASA_PASS=your_camera_password

# Proxmox PVE exporter (also update pve-exporter/pve.yml)
# Create API token: Datacenter -> Permissions -> API Tokens
PVE_TOKEN_VALUE=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Homarr (generated on first run, or set manually)
# SECRET_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32
# -> stored in homarr-secret.key.env (gitignored)

# Alertmanager webhook token (stored in alertmanager/webhook_token, gitignored)
# Generate with: openssl rand -hex 32
